{
  // ES2022 and nothing else: no DOM and no Node types, so code here that reaches for a browser or a server API
  // fails the typecheck. Everything that draws a diagram has to run in a Worker, a CLI and a page alike.
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022"], "types": [],
    "strict": true, "resolveJsonModule": true, "noEmit": true, "skipLibCheck": true
  },
  "include": ["src"]
}
