{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skope",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "skope.khorum-oss.org", "custom_domain": true }],
  // Without this, `wrangler dev` presents requests as coming to the route's hostname,
  // and the Worker's localhost-only DEV_USER_EMAIL sign-in would never apply.
  "dev": { "host": "localhost" },
  // dist/ is the SvelteKit build under /app (the site root redirects there) and _headers, the security headers
  // for every static file (scripts/assemble.mjs); wrangler dev and deploy build it first.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "build": { "command": "npm run build" },
  "d1_databases": [
    // A placeholder: `wrangler dev` and the tests use a local database. CI writes prod's real id (the
    // production environment's PROD_D1_ID) into wrangler.prod.jsonc at deploy time (scripts/prod-config.mjs).
    { "binding": "DB", "database_name": "skope", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": {
    // ACCESS_TEAM_DOMAIN: "https://" + the team domain, with no trailing slash
    "ACCESS_TEAM_DOMAIN": "https://khorum.cloudflareaccess.com",
    // ACCESS_AUD: the Access application's AUD tag. Empty here (locally DEV_USER_EMAIL signs you in); CI fills
    // prod's from the production environment's PROD_ACCESS_AUD.
    "ACCESS_AUD": ""
  }
}
