{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skope",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "skope.khorum-oss.org", "custom_domain": true }],
  // Without this, `wrangler dev` presents requests as coming to the route's hostname,
  // and the Worker's localhost-only DEV_USER_EMAIL sign-in would never apply.
  "dev": { "host": "localhost" },
  // dist/ is web/ (the prototype, at the site root) plus the SvelteKit build under /app; wrangler dev and deploy
  // build it first.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "build": { "command": "npm run build" },
  "d1_databases": [
    // database_id: the id printed by `wrangler d1 create skope`
    { "binding": "DB", "database_name": "skope", "database_id": "085c59a3-2e05-4ebe-95a5-e786c67fed16", "migrations_dir": "migrations" }
  ],
  "vars": {
    // ACCESS_TEAM_DOMAIN: "https://" + the team domain, with no trailing slash
    "ACCESS_TEAM_DOMAIN": "https://khorum.cloudflareaccess.com",
    // ACCESS_AUD: the Access application's AUD tag
    "ACCESS_AUD": "b4a57a6a85b08a120ffe79fe46ddd8b748ede90dada54a04e40bc1029d68038e"
  }
}
