{
  "name": "daidal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/auth-plugins.mjs && npm run build --prefix app && node scripts/assemble.mjs",
    "build:core": "node scripts/build-core.mjs",
    "test": "vitest run && npm run test:core && node --test scripts/*.test.mjs && npm test --prefix app",
    "release": "node scripts/release.mjs",
    "test:worker": "vitest run",
    "test:core": "vitest run -c packages/core/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/core && tsc --noEmit -p e2e && npm run check --prefix app",
    "deploy": "wrangler deploy",
    "stage-seed": "tsx scripts/stage-seed.ts",
    "e2e": "playwright test",
    "playwright:install": "playwright install --with-deps chromium",
    "demo": "argo pipeline tour",
    "demo:c4": "argo pipeline c4",
    "docs:shots": "npm run build && playwright test -c playwright.docs.config.ts"
  },
  "dependencies": {
    "@khorum/daidal-core": "file:packages/core",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.149.0"
  }
}
