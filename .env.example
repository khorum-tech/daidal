# Copy to .env and change what differs for your Daidal. The app reads these when it's built (npm run build), so the
# in-app docs (Docs → Connecting AI) give your addresses instead of daidal.khorum.org. Leave one out to keep the
# default shown. Variables set in the build's own environment work the same way.

# The Daidal people sign in to.
DAIDAL_URL=https://daidal.khorum.org

# Its stage site. Set it empty (DAIDAL_STAGE_URL=) if you have none, and the docs leave stage out.
DAIDAL_STAGE_URL=https://daidal-stage.khorum.org

# wrangler dev on your computer. The app's dev server (npm run dev --prefix app) sends /api here too.
DAIDAL_LOCAL_URL=http://localhost:8787

# The repository the docs link to, for the Claude skill.
DAIDAL_REPO_URL=https://github.com/khorum-tech/daidal
